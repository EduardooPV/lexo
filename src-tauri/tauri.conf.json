{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lexo",
  "mainBinaryName": "Lexo",
  "version": "2.0.1",
  "identifier": "com.luizveltroni.tradutor",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "popup",
        "title": "Lexo",
        "width": 520,
        "height": 250,
        "minWidth": 360,
        "minHeight": 120,
        "visible": false,
        "resizable": true,
        "center": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": false,
        "focus": true
      },
      {
        "label": "mini",
        "title": "Translation",
        "url": "mini.html",
        "width": 360,
        "height": 180,
        "visible": false,
        "resizable": false,
        "center": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "focus": true
      },
      {
        "label": "overlay",
        "title": "Select a region",
        "url": "overlay.html",
        "width": 800,
        "height": 600,
        "visible": false,
        "resizable": false,
        "center": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; media-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxRUVDRkE2Mjk0Mjg1NjUKUldSbGhVSXBwcy91UVpraVFqMVREaVg2dDZRbGlFMlB1RC93cnNDaUNBMW1mbXl3cCtISThIdUYK",
      "endpoints": [
        "https://github.com/EduardooPV/lexo/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
